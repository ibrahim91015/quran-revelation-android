  <style name="AccentEmerald" parent="AccentBase">
    <item name="quranAccent">@color/accent_emerald</item>
    <item name="colorPrimaryContainer">@color/accent_emerald_container</item>
  </style>
  <style name="AccentViolet" parent="AccentBase">
    <item name="quranAccent">@color/accent_violet</item>
    <item name="colorPrimaryContainer">@color/accent_violet_container</item>
  </style>
  <style name="AccentAmber" parent="AccentBase">
    <item name="quranAccent">@color/accent_amber</item>
    <item name="colorPrimaryContainer">@color/accent_amber_container</item>
  </style>
</resources>
